# Copy this to .env.local and fill values.
OPENROUTER_API_KEY=
BLOB_READ_WRITE_TOKEN=      // needed for blob storage of personalized content, as well as blob-based indexing fallback
EDGE_CONFIG_ID=             // optional, but needed for edge config-based indexing
EDGE_CONFIG_TOKEN=          // needed for edge config index writes, not required for basic read/write functionality
NEXT_PUBLIC_BASE_URL=       //ur deployment url
